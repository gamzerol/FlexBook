generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  PERSON
  ASSET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Business {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  sector       String?
  email        String   @unique
  passwordHash String
  phone        String?
  timezone     String   @default("Europe/Istanbul")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resources     Resource[]
  services      Service[]
  customers     Customer[]
  bookings      Booking[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  familyId   String
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([familyId])
}

model Resource {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  type       ResourceType @default(PERSON)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  services          ResourceService[]

  @@index([businessId])
}

model Service {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal? @db.Decimal(10, 2)
  description     String?
  metadata        Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  resources ResourceService[]
  bookings  Booking[]

  @@index([businessId])
}

model ResourceService {
  resourceId String
  serviceId  String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([resourceId, serviceId])
}

model AvailabilityRule {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String

  @@index([resourceId, dayOfWeek])
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  createdAt  DateTime @default(now())

  bookings Booking[]

  @@unique([businessId, phone])
}

model Booking {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    Resource      @relation(fields: [resourceId], references: [id])
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  @@index([resourceId, startTime, endTime])
}
